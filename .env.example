# TEMPLATE ONLY. Copy to .env and put real values there. NEVER put real keys in this file.
# One OpenAI-compatible client serves all providers.
LLM_PROVIDER=ollama                         # ollama | groq | gemini
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama                          # Ollama ignores it; required for groq/gemini

# Groq:   LLM_PROVIDER=groq
#         LLM_BASE_URL=https://api.groq.com/openai/v1
#         LLM_MODEL=openai/gpt-oss-120b
#         LLM_API_KEY=gsk_your_key_here
# Gemini: LLM_PROVIDER=gemini
#         LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#         LLM_MODEL=gemini-flash-model-id
#         LLM_API_KEY=your_key_here

LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=4096
# LLM_REASONING_EFFORT=low                  # gpt-oss on Groq defaults to low; leave unset for Ollama
SANITIZER_USE_LLM=true

# ROI dashboard cost estimate (USD per 1M tokens). Copy from your provider's pricing page; 0 for local Ollama.
LLM_COST_PER_1M_INPUT=0
LLM_COST_PER_1M_OUTPUT=0

# Optional: override DB location (default data/gulf_horizon_1k_txns.sqlite)
# GH_DB_PATH=data/gulf_horizon_1k_txns.sqlite
